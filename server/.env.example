# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=3000

# Base de datos (usuario creado con database/00-usuario-dev.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=podio
DB_PASSWORD=podio_dev_2026
DB_NAME=torneos_db

# Autenticación: usa una cadena larga y aleatoria
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Origen permitido del frontend (Vite)
CORS_ORIGIN=http://localhost:5173

# --- Producción (Render + Aiven) ---
# SSL obligatorio en Aiven: DB_SSL=true y el certificado CA (puede ir en una sola
# línea con \n en lugar de saltos de línea)
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Intentos de login/registro por IP cada 15 minutos (por defecto 20)
# AUTH_RATE_LIMIT=20
